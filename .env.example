# Copy to .env.local and fill in (Supabase Dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Development only (ignored by production builds) ---
# `npm run dev` signs you in automatically as dev_user@example.com (see seed.sql).
# Open /?as=alice or /?as=bob to be someone else, /?as=none to see the real login.
# VITE_DEV_AUTO_LOGIN=false      # turn the auto sign-in off entirely
